# Salt per hash IP rate limiting avanzato (GDPR compliant)
ADV_THROTTLE_SALT=change-me
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Provider da usare: yahoo_finance (consigliato) o alpha_vantage
ASSET_PRICE_PROVIDER=yahoo_finance

# Yahoo Finance via RapidAPI (consigliato)
# Registrazione: https://rapidapi.com/apidojo/api/yahoo-finance1/
YAHOO_FINANCE_API_KEY=

# Alpha Vantage (opzionale, come fallback)
ALPHA_VANTAGE_API_KEY=

GOOGLE_SITE_VERIFICATION=

# Telegram Bot — collegamento account e ricezione spese via chat
# Token ottenuto da @BotFather su Telegram
TELEGRAM_BOT_TOKEN=
# Username del bot (senza @), es: finanzamente_bot
TELEGRAM_BOT_USERNAME=

# Mistral AI — OCR scontrini via Vision API (Pixtral)
# Registrazione: https://console.mistral.ai/
MISTRAL_API_KEY=
# Google Drive — importazione file da Google Drive
# Crea un progetto su https://console.cloud.google.com/
# 1. Abilita le API: "Google Drive API" e "Google Picker API"
# 2. Crea una credenziale OAuth 2.0 (tipo: Web application)
#    - Aggiungi gli URI di reindirizzamento autorizzati (es. http://localhost)
# 3. Crea una chiave API per il Picker
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=

# -------------------------------------------------------------------------
# Mollie — Sistema di pagamento per il pacchetto Pro
# -------------------------------------------------------------------------
# Registrazione: https://www.mollie.com/it
# API key: test_... per sviluppo, live_... per produzione
MOLLIE_KEY=

# URL di ritorno dopo il checkout Mollie (impostato automaticamente, può essere
# sovrascritto per ambienti particolari)
# MOLLIE_REDIRECT_URL=

# Segreto opzionale per la verifica dei webhook (non usato da Mollie natively,
# ma utile per proteggere l'endpoint in ambienti particolari)
MOLLIE_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# Piani e abbonamenti
# -------------------------------------------------------------------------
# Abilita/disabilita l'acquisto del piano Pro (true/false)
PRO_PLAN_ENABLED=true

# Sconto percentuale applicato al piano annuale Pro (es. 20 = 20%)
PRO_ANNUAL_DISCOUNT_PERCENT=20

# Prezzo mensile del piano Pro in centesimi di Euro (es. 990 = 9,90 €)
PRO_PRICE_MONTHLY_CENTS=990

# ID piano Mollie per abbonamenti mensili/annuali (generati nel pannello Mollie)
# Opzionali: usati solo se si gestiscono i piani direttamente da Mollie dashboard
# MOLLIE_PRO_PLAN_ID_MONTHLY=
# MOLLIE_PRO_PLAN_ID_ANNUAL=

# -------------------------------------------------------------------------
# Pre-Lancio
# -------------------------------------------------------------------------
# Attiva la modalità pre-lancio: solo il proprietario può accedere alla dashboard
# e registrarsi. Altri utenti vengono reindirizzati alla homepage.
PRE_LAUNCH_MODE=false

# Email del proprietario autorizzato in modalità pre-lancio
PRE_LAUNCH_OWNER_EMAIL=
MAGAZINE_ADMIN_EMAIL=         # se vuota, usa PRE_LAUNCH_OWNER_EMAIL come fallback

# Attiva la modalità waitlist: il CTA Pro viene sostituito con il form "Avvisami al lancio"
PRO_WAITLIST_ENABLED=false

# -------------------------------------------------------------------------
# Brevo (ex Sendinblue) — Waitlist Pro e double opt-in
# -------------------------------------------------------------------------
# Registrazione: https://www.brevo.com/
# API key ottenuta dal pannello Brevo (Settings > API Keys)
BREVO_API_KEY=

# ID della lista Brevo su cui iscrivere i contatti della waitlist
BREVO_WAITLIST_LIST_ID=

# ID del template email di double opt-in configurato su Brevo
# (Settings > Email Templates, crea un template di tipo "Double Opt-In")
BREVO_DOUBLE_OPTIN_TEMPLATE_ID=

# URL di redirect dopo la conferma del double opt-in
BREVO_DOUBLE_OPTIN_REDIRECT_URL=


# ID del form Tally.so per il micro-sondaggio interesse (opzionale).
# Crea il form su https://tally.so e copia l'ID dall'URL (es. wMeXYZ).
# Lascia vuoto per non mostrare il link al sondaggio nella card Pro waitlist.
TALLY_SURVEY_FORM_ID=
TALLY_WEBHOOK_SECRET=

# Backup database con cripting
BACKUP_ENCRYPTION_KEY=
