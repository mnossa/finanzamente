###############################################################################
# Finanzamente — environment template
# Copy to `.env` and fill values. Generate APP_KEY with:
#   make up && docker compose exec app php artisan key:generate
###############################################################################

# -----------------------------------------------------------------------------
# Required — application
# -----------------------------------------------------------------------------
# Salt for hashing IPs in advanced rate limiting (GDPR: no plaintext IP in logs).
# REQUIRED: replace with a long random string before first run (e.g. openssl rand -base64 32).
# Do not leave the placeholder value in a real deployment.
ADV_THROTTLE_SALT=change-me-to-a-long-random-string

APP_NAME=Finanzamente
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
# Public URL of this install (no trailing slash)
APP_URL=http://localhost:8080

# Vite HMR port inside Docker (default compose mapping)
VITE_PORT=5174

# Email used for Pulse/Telescope admin gate (optional; leave empty to deny)
APP_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# Optional — Laravel Telescope / Pulse (local diagnostics)
# -----------------------------------------------------------------------------
TELESCOPE_ENABLED=false
PULSE_ENABLED=true
PULSE_DB_CONNECTION=pulse
# PULSE_DB_DATABASE=   # default: storage/pulse/pulse.sqlite

LOG_CHANNEL=daily
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Required — database (MySQL in Docker Compose)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=finanzamente
DB_USERNAME=finanzamente
DB_PASSWORD=finanzamente
DB_ROOT_PASSWORD=finanzamente

# -----------------------------------------------------------------------------
# Required — cache / queue / session (Redis in Docker Compose)
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Required — mail
# Local Docker: Mailpit (http://localhost:8025). Production: your SMTP provider.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@finanzamente.local"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Optional — feature flags
# -----------------------------------------------------------------------------
# Step-by-step guided create forms on "Nuovo …" pages
FEATURE_GUIDED_CREATE_FORMS=true

# -----------------------------------------------------------------------------
# Optional — Telegram bot (expenses via chat + account link)
# Create a bot with @BotFather → copy token and username.
# Register webhook to: {APP_URL}/telegram/webhook
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: set the same secret when registering the webhook (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Optional — Google Drive (import files from Drive picker)
# Cloud Console: https://console.cloud.google.com/
# Enable "Google Drive API" + "Google Picker API".
# Create OAuth 2.0 Web client + API key; add authorized JS origins (APP_URL).
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_API_KEY=

# -----------------------------------------------------------------------------
# Optional — Google Sheets (artisan household export)
# Enable "Google Sheets API" + "Google Drive API".
# Create a Service Account, download JSON into storage/app/, set path below.
# Share the target spreadsheet (Editor) with the service account email.
# Optional: GOOGLE_SHEETS_SHARE_WITH = Google account to auto-share new sheets.
# Export to an existing sheet:
#   make export-google-sheets spreadsheet=SPREADSHEET_ID
#   make export-google-sheets spreadsheet=SPREADSHEET_ID user=1 household=2
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_SHARE_WITH=

# Optional SEO verification meta (Google Search Console)
GOOGLE_SITE_VERIFICATION=

# -----------------------------------------------------------------------------
# Optional — encrypted DB backups (spatie/laravel-backup if configured)
# -----------------------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Optional — Python FastAPI helper (cohort insights)
# Docker Compose service default:
# -----------------------------------------------------------------------------
PYTHON_SERVICES_URL=http://python-services:8000
PYTHON_SERVICES_MANAGE_PROCESS=true
PYTHON_SERVICES_STARTUP_TIMEOUT=120
PYTHON_SERVICES_SHUTDOWN_AFTER_USE=true

COHORT_INSIGHTS_ENABLED=true
COHORT_INSIGHTS_K_MIN=50
COHORT_INSIGHTS_MIN_EXPENSE=100
COHORT_INSIGHTS_MEDIAN_GAP=15

# -----------------------------------------------------------------------------
# Optional — WebAuthn / passkeys
# Secret used to derive user handles. Set a long random string in real deploys.
# RP ID / origins default from APP_URL; override only if needed.
# -----------------------------------------------------------------------------
PASSKEYS_USER_HANDLE_SECRET=
# PASSKEYS_RP_ID=localhost
# PASSKEYS_ALLOWED_ORIGINS=http://localhost:8080
