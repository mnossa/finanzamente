# Docker environment variables
# Imposta UID e GID per evitare problemi di permessi
UID=1000
GID=1001


# Configurazione database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=finanzamente
DB_USERNAME=finanzamente
DB_PASSWORD=finanzamente

# Servizio semantico per suggerimenti link interni magazine
PYTHON_LINKER_URL=http://python-linker:8000
