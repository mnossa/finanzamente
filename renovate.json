{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],

    "timezone": "Europe/Rome",
    "schedule": ["before 6am on Monday"],

    "prConcurrentLimit": 3,
    "prHourlyLimit": 0,
    "minimumReleaseAge": "7 days",

    "dependencyDashboard": true,
    "dependencyDashboardApproval": true,

    "packageRules": [
        {
            "matchUpdateTypes": ["patch"],
            "automerge": true,
            "automergeType": "pr",
            "dependencyDashboardApproval": false
        },
        {
            "groupName": "laravel/framework",
            "matchManagers": ["composer"],
            "matchPackageNames": ["laravel/framework"]
        },
        {
            "groupName": "Altri pacchetti Laravel",
            "matchManagers": ["composer"],
            "matchPackagePatterns": ["^laravel/"],
            "excludePackageNames": ["laravel/framework"]
        },
        {
            "groupName": "Spatie",
            "matchManagers": ["composer"],
            "matchPackagePatterns": ["^spatie/"]
        },
        {
            "groupName": "PHP dev tools",
            "matchManagers": ["composer"],
            "matchPackageNames": [
                "phpunit/phpunit",
                "fakerphp/faker",
                "mockery/mockery",
                "nunomaduro/collision"
            ]
        },
        {
            "groupName": "Altri pacchetti PHP",
            "matchManagers": ["composer"],
            "matchPackagePatterns": [
                "^artesaos/",
                "^mollie/",
                "^openspout/",
                "^tightenco/"
            ]
        },
        {
            "groupName": "Inertia.js",
            "matchPackagePatterns": ["^inertiajs/", "^@inertiajs/"]
        },
        {
            "groupName": "React core",
            "matchManagers": ["npm"],
            "matchPackageNames": ["react", "react-dom"]
        },
        {
            "groupName": "React ecosystem",
            "matchManagers": ["npm"],
            "matchPackageNames": [
                "@types/react",
                "@types/react-dom",
                "@headlessui/react",
                "@heroicons/react"
            ]
        },
        {
            "groupName": "Tailwind CSS",
            "matchManagers": ["npm"],
            "matchPackagePatterns": ["^tailwindcss$", "^@tailwindcss/", "^autoprefixer$", "^postcss"]
        },
        {
            "groupName": "Vite",
            "matchManagers": ["npm"],
            "matchPackagePatterns": ["^vite$", "^@vitejs/", "^laravel-vite-plugin$"]
        },
        {
            "groupName": "TypeScript e @types",
            "matchManagers": ["npm"],
            "matchPackagePatterns": ["^typescript$", "^@types/"]
        },
        {
            "groupName": "@dnd-kit",
            "matchManagers": ["npm"],
            "matchPackagePatterns": ["^@dnd-kit/"]
        },
        {
            "groupName": "Playwright",
            "matchManagers": ["npm"],
            "matchPackageNames": ["@playwright/test"]
        }
    ]
}

