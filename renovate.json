{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Rome)"
  ],
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "minimumReleaseAge": "7 days",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,

  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "rangeStrategy": "update-lockfile"
  },

  "packageRules": [
    {
      "description": "ZONA SICURA: Automerge per pacchetti che non impattano la logica di business",
      "matchPackageNames": [
        "typescript",
        "/^@types//",
        "tailwindcss",
        "postcss",
        "autoprefixer",
        "phpunit/phpunit",
        "fakerphp/faker",
        "mockery/mockery",
        "nunomaduro/collision",
        "@playwright/test",
        "prettier",
        "eslint"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "dependencyDashboardApproval": false
    },
    {
      "description": "ZONA CRITICA: Framework e Pagamenti (Richiedono sempre approvazione manuale)",
      "matchPackageNames": [
        "laravel/framework",
        "react",
        "react-dom",
        "/^mollie//",
        "/^spatie//",
        "/^inertiajs//",
        "/^@inertiajs//"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "Laravel Core & Ecosystem",
      "matchManagers": ["composer"],
      "matchPackageNames": ["laravel/framework", "/^laravel//"]
    },
    {
      "groupName": "React & Inertia",
      "matchPackageNames": [
        "react", 
        "react-dom", 
        "/^inertiajs//", 
        "/^@inertiajs//",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "Tailwind & Style",
      "matchPackageNames": [
        "tailwindcss",
        "/^@tailwindcss//",
        "autoprefixer",
        "/^postcss/"
      ]
    },
    {
      "groupName": "Build Tools (Vite)",
      "matchPackageNames": [
        "vite",
        "/^@vitejs//",
        "laravel-vite-plugin"
      ]
    },
    {
      "groupName": "Utility PHP",
      "matchManagers": ["composer"],
      "matchPackageNames": [
        "/^artesaos//",
        "/^openspout//",
        "/^tightenco//"
      ]
    },
    {
      "groupName": "Drag & Drop Kit",
      "matchPackageNames": ["/^@dnd-kit//"]
    }
  ]
}