# =============================================================================
# Dockerfile.prod — Multi-stage build per produzione
# =============================================================================
# Stage 1: Compilazione asset frontend (Node.js)
# Stage 2: Installazione dipendenze PHP (Composer)
# Stage 3: Pacchetti Python + download modello ML (sentence-transformers)
# Stage 4: Immagine finale di produzione (PHP-FPM + Nginx + Python via supervisord)
# =============================================================================

# ─── Stage 1: Build asset frontend ───────────────────────────────────────────
FROM node:24-alpine AS node-builder

WORKDIR /app

# Copia manifest prima del codice sorgente (ottimizza la cache dei layer)
COPY package*.json ./
RUN npm ci --frozen-lockfile

# Copia tutto il codice sorgente e compila
COPY . .
RUN npm run build

# ─── Stage 2: Dipendenze PHP di produzione ────────────────────────────────────
FROM composer:2.9 AS composer-builder

# Usa una home esplicita e scrivibile per Composer (evita fallback su "/.composer")
ENV HOME=/tmp \
    COMPOSER_HOME=/tmp/composer \
    COMPOSER_CACHE_DIR=/tmp/composer/cache
RUN mkdir -p /tmp/composer/cache

WORKDIR /app

# Copia solo i file Composer per la cache dei layer
COPY composer.json composer.lock ./
# --ignore-platform-reqs: l'immagine composer:2.9 usa PHP 8.5 mentre alcune
# dipendenze (es. openspout) richiedono ~8.2/8.3/8.4. Le platform requirements
# vengono soddisfatte nello stage production (php:8.5-fpm).
RUN composer install \
    --optimize-autoloader \
    --no-dev \
    --no-interaction \
    --no-scripts \
    --prefer-dist \
    --ignore-platform-reqs

# Copia il codice per i post-install scripts e rigenera l'autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev --ignore-platform-reqs

# ─── Stage 3: Python deps + modello ML ────────────────────────────────────────
# NOTA: usare la stessa versione Python disponibile via apt nell'immagine di produzione
# (php:8.5-fpm è basata su Debian Trixie che fornisce python3.13)
FROM python:3.13-slim AS python-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
    && rm -rf /var/lib/apt/lists/*

COPY python-services/requirements.txt .

# Installa PyTorch CPU-only PRIMA di requirements.txt:
# sentence-transformers tirerebbe la variante CUDA (~2GB), quella CPU è ~200MB.
# Pip vedrà torch già soddisfatto e non lo reinstallerà.
RUN pip install --no-cache-dir --target=/python-packages \
        torch --index-url https://download.pytorch.org/whl/cpu

# Installa le restanti dipendenze (torch è già presente, non verrà riscaricato)
RUN pip install --no-cache-dir --target=/python-packages -r requirements.txt

# Pre-scarica il modello nel HuggingFace cache (evita download a runtime)
RUN PYTHONPATH=/python-packages python3 -c \
    "from sentence_transformers import SentenceTransformer; SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2')"

# ─── Stage 4: Immagine di produzione ─────────────────────────────────────────
FROM php:8.5-fpm AS production

ARG BUILD_DATE
ARG GIT_SHA
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_SHA}"
LABEL org.opencontainers.image.source="https://github.com/mnossa/finanzamente"

# Installa dipendenze di sistema, nginx, supervisor, Python e estensioni PHP
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        curl \
        python3 \
        # Build deps per le estensioni PHP
        libpng-dev \
        libjpeg-dev \
        libfreetype6-dev \
        libwebp-dev \
        libonig-dev \
        libxml2-dev \
        libzip-dev \
        libicu-dev \
        zip \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
    && rm -rf /var/lib/apt/lists/* \
    # Rimuove il vhost default di Debian nginx (evita "duplicate default server" con il nostro conf.d/default.conf)
    && rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default

# Usa la configurazione PHP ottimizzata per produzione
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

WORKDIR /var/www

# Copia il codice sorgente dell'applicazione
COPY --chown=www-data:www-data . .

# Copia gli asset compilati dallo stage Node.js
COPY --from=node-builder --chown=www-data:www-data /app/public/build ./public/build

# Copia le dipendenze PHP dallo stage Composer
COPY --from=composer-builder --chown=www-data:www-data /app/vendor ./vendor

# Copia pacchetti Python e modello pre-scaricato dallo stage python-builder
COPY --from=python-builder /python-packages /python-packages
COPY --from=python-builder /root/.cache /root/.cache
COPY python-services/main.py python-services/magazine_linker.py python-services/cohort_insights.py /python-services/

# Imposta PYTHONPATH per uvicorn (servizi Python ausiliari)
ENV PYTHONPATH=/python-packages

# Copia le configurazioni Docker
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/php-fpm.conf /usr/local/etc/php-fpm.d/zz-finanzamente.conf
COPY docker/php.prod.ini "$PHP_INI_DIR/conf.d/99-finanzamente.ini"
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

# Crea directory necessarie e imposta permessi
RUN mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/framework/testing \
        storage/logs \
        bootstrap/cache \
        /run/php \
        /run/nginx \
    && chown -R www-data:www-data /var/www \
    && chmod -R 755 /var/www/storage \
    && chmod -R 755 /var/www/bootstrap/cache

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -sf http://localhost/up || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
