# Copia in .env.db-pull (gitignored) per make db-pull-prod / make db-import-local

# SSH verso il server di produzione
PROD_SSH_HOST=your-server.example.com
PROD_SSH_USER=user
PROD_SSH_PORT=22
# PROD_SSH_KEY=/home/you/.ssh/finanzamente_deploy

# Directory sul server dove gira docker compose prod
PROD_COMPOSE_DIR=/var/www
PROD_COMPOSE_FILE=docker-compose.prod.yml
PROD_DB_SERVICE=db

# Modalità pull:
# - dump (default): mysqldump live dal container DB
#   Usa DB_ROOT_PASSWORD dal .env remoto se presente (consigliato).
#   Con solo DB_USERNAME evita FLUSH TABLES (dump ok per dev locale).
# - latest-backup: scarica l'ultimo .sql.gz.enc dal volume backup (stesso flusso del backup notturno)
DB_PULL_MODE=dump

# Solo per latest-backup o import di file .enc (stessa chiave usata in produzione)
# BACKUP_ENCRYPTION_KEY=

# Dopo import: make db-anonymize (sostituisce email, nomi, descrizioni, ecc.)

# Override import locale
# LOCAL_DB_CONTAINER=dbcontainer
# LOCAL_DB_NAME=userdb
# LOCAL_DB_USER=root
# LOCAL_DB_PASSWORD=root
