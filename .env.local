# -------------------------------------------------------------------------
# Mollie — Sistema di pagamento per il pacchetto Pro
# -------------------------------------------------------------------------
# Registrazione: https://www.mollie.com/it
# API key: test_... per sviluppo, live_... per produzione
MOLLIE_KEY=

# URL di ritorno dopo il checkout Mollie (impostato automaticamente, può essere
# sovrascritto per ambienti particolari)
# MOLLIE_REDIRECT_URL=

# Segreto opzionale per la verifica dei webhook (non usato da Mollie natively,
# ma utile per proteggere l'endpoint in ambienti particolari)
MOLLIE_WEBHOOK_SECRET=

# -------------------------------------------------------------------------
# Piani e abbonamenti
# -------------------------------------------------------------------------
# Abilita/disabilita l'acquisto del piano Pro (true/false)
PRO_PLAN_ENABLED=false

# Sconto percentuale applicato al piano annuale Pro (es. 20 = 20%)
PRO_ANNUAL_DISCOUNT_PERCENT=20

# Prezzo mensile del piano Pro in centesimi di Euro (es. 990 = 9,90 €)
PRO_PRICE_MONTHLY_CENTS=290

# ID piano Mollie per abbonamenti mensili/annuali (generati nel pannello Mollie)
# Opzionali: usati solo se si gestiscono i piani direttamente da Mollie dashboard
# MOLLIE_PRO_PLAN_ID_MONTHLY=
# MOLLIE_PRO_PLAN_ID_ANNUAL=


# -------------------------------------------------------------------------
# Pre-Lancio
# -------------------------------------------------------------------------
# Attiva la modalità pre-lancio: solo il proprietario può accedere alla dashboard
# e registrarsi. Altri utenti vengono reindirizzati alla homepage.
PRE_LAUNCH_MODE=true

# Email del proprietario autorizzato in modalità pre-lancio
PRE_LAUNCH_OWNER_EMAIL=

# Attiva la modalità waitlist: il CTA Pro viene sostituito con il form "Avvisami al lancio"
PRO_WAITLIST_ENABLED=true
TALLY_SURVEY_FORM_ID=

# -------------------------------------------------------------------------
# Brevo (ex Sendinblue) — Waitlist Pro e double opt-in
